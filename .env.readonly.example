# ══════════════════════════════════════════════════════════════
# 只读模式配置模板
#
# 用法:
#   cp .env.readonly.example .env
#   # 填入 SHELL_API_TOKEN 与 SHELL_API_FS_ROOT
#   ./start.sh start
#   ./start.sh readonly-check    # 验证只读确实生效
#
# 注意: .env 会被 start.sh source,且已在 .gitignore 中,不要提交。
# ══════════════════════════════════════════════════════════════

# ── 只读模式开关(优先级最高)───────────────────────────────────
# 开启后强制关闭全部写能力:命令执行、会话、写/编辑/删除/移动/复制/建目录。
# 该开关无法被 SHELL_API_DISABLED_TOOLS 或任何请求参数覆盖,
# 也无法在进程运行期间关闭。
SHELL_API_READONLY=true

# ── 鉴权(必填)────────────────────────────────────────────────
# 生成: openssl rand -hex 32
SHELL_API_TOKEN=

# ── 可读范围(强烈建议设置)────────────────────────────────────
# 只读模式管"不能改",FSRoot 管"能读到哪";逗号分隔多个目录前缀。
# 留空则可读取整台主机上进程权限所及的任何文件。
SHELL_API_FS_ROOT=/home/work

# ── 监听 ───────────────────────────────────────────────────────
SHELL_API_PORT=8080

# ── 传输安全(生产环境建议启用 TLS)──────────────────────────
# SHELL_API_TLS_CERT=./cert.pem
# SHELL_API_TLS_KEY=./key.pem

# ── 限额 ───────────────────────────────────────────────────────
SHELL_API_MAX_OUTPUT=1048576
SHELL_API_RATE_LIMIT=60

# ── 可选:在只读模式基础上进一步收窄(只能更严,不能更宽)──────
# 例如连 base64 下载和进程枚举也不给:
# SHELL_API_DISABLED_TOOLS=remote_download_base64,remote_list_processes
