# agentic-remotectl 2.0 — slaver template
#
# A slaver has no public HTTP listener and no MCP endpoint. It dials the
# master and serves tool invokes over that control connection.

REMOTECTL_MODE=slaver

# Required: master control endpoint (host:port; http:// or https:// prefixes
# are accepted and ignored for the token-only 2.0 transport).
REMOTECTL_MASTER_URL=master.example.com:9443
REMOTECTL_CLUSTER_TOKEN=rct_replace-with-the-cluster-token
# Or keep it out of shell history / env.conf:
# REMOTECTL_CLUSTER_TOKEN_FILE=/etc/agentic-remotectl/cluster-token

# Human-readable alias; defaults to the hostname. node_id is generated once
# in <state>/slaver/node-id and survives restarts.
# REMOTECTL_NODE_NAME=prod-db-01
# REMOTECTL_NODE_ID=<uuid override>

# State directory: node identity, job manifests.
# REMOTECTL_STATE_DIR=/var/lib/agentic-remotectl

# Local policy is enforced on the slaver and cannot be relaxed by the master.
# REMOTECTL_READONLY=true
# REMOTECTL_FS_ROOT=/data
# REMOTECTL_DENY_COMMANDS='(^|\s)(rm|shutdown)(\s|$)'

# Heartbeat / lease (defaults keep 2.0 behavior)
# REMOTECTL_HEARTBEAT_SEC=10
# REMOTECTL_LEASE_TTL_SEC=30
