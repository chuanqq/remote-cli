# agentic-remotectl 2.0 — master admin template
#
# Use this only on a controlled operations node: it exposes node approve /
# revoke / forget to every authenticated MCP client (single-Bearer model).

REMOTECTL_MODE=master
REMOTECTL_LISTEN=127.0.0.1:8099
REMOTECTL_TOKEN=replace-with-a-long-random-token
# REMOTECTL_TOKEN_HASH=sha256:<salt-hex>:<hash-hex>

REMOTECTL_CONTROL_LISTEN=0.0.0.0:9443
REMOTECTL_CLUSTER_TOKEN_HASH=sha256:<salt-hex>:<hash-hex>
REMOTECTL_NODE_APPROVAL=manual
REMOTECTL_MASTER_LOCAL=on

# Explicit admin opt-in (D10/D29). Keep this false on ordinary read-write
# masters.
REMOTECTL_ENABLE_NODE_ADMIN_TOOLS=true
