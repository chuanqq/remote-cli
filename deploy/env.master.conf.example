# agentic-remotectl 2.0 — master template
#
# The master is the only public MCP endpoint. It also executes locally by
# default; set REMOTECTL_MASTER_LOCAL=off to route every target call to a
# slaver.

REMOTECTL_MODE=master

# Public MCP listener and client credential
REMOTECTL_LISTEN=0.0.0.0:8099
REMOTECTL_TOKEN=replace-with-a-long-random-token
# REMOTECTL_TOKEN_HASH=sha256:<salt-hex>:<hash-hex>

# Control channel: REQUIRED, no default port (deliberately).
REMOTECTL_CONTROL_LISTEN=0.0.0.0:9443

# Pre-shared cluster token, stored only as a salted hash.
# Generate with: agentic-remotectl cluster-token create
REMOTECTL_CLUSTER_TOKEN_HASH=sha256:<salt-hex>:<hash-hex>
# Rotation state file alternative:
# REMOTECTL_STATE_DIR=/var/lib/agentic-remotectl
# agentic-remotectl cluster-token rotate --state-dir /var/lib/agentic-remotectl

# Node approval: auto | manual | allowlist (production: manual or allowlist)
REMOTECTL_NODE_APPROVAL=manual
# REMOTECTL_NODE_ALLOWLIST=<node-uuid>,<node-uuid>

# Local execution on the master (on keeps 1.x behavior)
REMOTECTL_MASTER_LOCAL=on

# Node management write tools (approve/revoke/forget). Keep false on ordinary
# read-write masters; use the admin template for controlled operations.
REMOTECTL_ENABLE_NODE_ADMIN_TOOLS=false

# The control channel is token-authenticated in 2.0 (mTLS is TODO-1), so bind
# it to a trusted network only.
