# agentic-remotectl 2.0 — standalone template (1.x-compatible default)
#
# Copy to env.conf next to the binary. Only the variables you need; every
# value can also be set in the process environment (REMOTECTL_* wins over the
# legacy SHELL_API_* names).

# standalone | master | slaver. Leave unset for standalone.
# REMOTECTL_MODE=standalone

# Public MCP listener. A non-loopback listener requires an explicit token.
REMOTECTL_LISTEN=127.0.0.1:8099
REMOTECTL_TOKEN=replace-with-a-long-random-token
# Or store only a salted hash (generate with: agentic-remotectl hash-token):
# REMOTECTL_TOKEN_HASH=sha256:<salt-hex>:<hash-hex>

# Optional limits and sandbox
# REMOTECTL_MAX_TIMEOUT=300
# REMOTECTL_FS_ROOT=/data
# REMOTECTL_READONLY=false

# State directory: node identity, node registry, job manifests.
# Default: <deploy dir>/state
# REMOTECTL_STATE_DIR=/var/lib/agentic-remotectl
