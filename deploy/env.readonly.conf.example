# agentic-remotectl 2.0 — read-only template
#
# Read-only mode is an allowlist: only the read tools are registered and every
# mutating operation fails closed. It cannot be re-enabled at runtime.

REMOTECTL_MODE=standalone
REMOTECTL_LISTEN=127.0.0.1:8099
REMOTECTL_TOKEN=replace-with-a-long-random-token
# REMOTECTL_TOKEN_HASH=sha256:<salt-hex>:<hash-hex>

REMOTECTL_READONLY=true

# Recommended with read-only mode: limit what can be read.
REMOTECTL_FS_ROOT=/data

# Node management read tools (remote_node_list/status) remain available on a
# master; the write tools are never registered in read-only mode.
